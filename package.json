{
  "name": "parts-market-interview",
  "version": "1.0.0",
  "private": true,
  "description": "Market research & interview app for an automotive spare-parts marketplace. Persian / RTL / mobile-first.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "prisma generate --schema prisma/schema.test.prisma",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:test:push": "prisma db push --schema prisma/schema.test.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate && prisma generate --schema prisma/schema.test.prisma",
    "hash:password": "tsx prisma/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "google-auth-library": "^9.15.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines": true,
    "prisma@6.19.3": true,
    "unrs-resolver": true
  }
}
