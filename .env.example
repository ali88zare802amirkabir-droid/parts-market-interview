# ------------------------------------------------------------------
# Parts Market Research — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Database -------------------------------------------------------
# PostgreSQL connection string (used by Prisma). On Render use the
# internal Database URL provided by the Render PostgreSQL service.
DATABASE_URL="postgresql://user:password@localhost:5432/parts_research?schema=public"

# --- Admin authentication ------------------------------------------
# Username used to log in to the research dashboard.
ADMIN_USERNAME="admin"
# bcrypt hash of the admin password. Generate one with:
#   npm run hash:password -- "your-password"
# NOTE: bcrypt hashes contain `$` which dotenv-expand expands, so escape them
# as `\$` (see the value below). Default provided hash corresponds to:
#   username: admin  /  password: Interview2026!
ADMIN_PASSWORD_HASH="\$2a\$10\$RUEC/L8RtlYxJxyV8V/wpOnj0qxKG7HXC9BpGwlnOLmUYl67Tq682"

# Secret used to sign admin session tokens (JWT / HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# When true, cookies are marked Secure and JWT has a short expiry (7 days).
NODE_ENV="development"

# --- Google Sheets sync (optional) ---------------------------------
# Enabled only when GOOGLE_SHEETS_ENABLED === "true".
GOOGLE_SHEETS_ENABLED="false"
# Google Cloud service account email with Sheets editor access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Private key of the service account (keep the \n escapes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Id of the target Google Spreadsheet.
GOOGLE_SHEET_ID=""
# Sheet tab name to write into.
GOOGLE_SHEET_RANGE="Sheet1"